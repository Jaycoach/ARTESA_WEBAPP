# Plantilla de variables de entorno — Portal La Artesa
# Los valores reales viven en el .env de cada servidor (nunca se versionan).
# Este archivo solo documenta los NOMBRES y el formato esperado.

# --- Aplicación / servidor ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=
TZ=America/Bogota
CONTAINER_NAME=
DOCKER_ENV=
LOG_DIR=
LOG_LEVEL=info
HEALTH_CHECK_ENABLED=true

# --- Base de datos (PostgreSQL / RDS) ---
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_MODE=require

# --- JWT / autenticación ---
JWT_SECRET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_IN_DEV=false
CORS_CREDENTIALS=true
CORS_HEADERS=
CORS_METHODS=
CORS_DEBUG_MODE=false
NGINX_CORS_ORIGINS=

# --- Rate limiting ---
RATE_LIMIT_STANDARD=
RATE_LIMIT_SENSITIVE=
RATE_LIMIT_WINDOW=

# --- reCAPTCHA ---
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_BYPASS=false

# --- AWS (S3 / SES) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
STORAGE_MODE=s3
S3_FORCE_PATH_STYLE=false
S3_DISABLE_ACL=false
S3_CUSTOM_DOMAIN=
S3_IMAGES_STRUCTURE=
S3_TIMEZONE_OFFSET=
S3_URL_EXPIRATION=
S3_URL_OPTIMIZATION=
S3_URL_SAFETY_MARGIN=

# --- Correo (AWS SES vía SMTP, EmailService.js) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SES_REGION=
SES_VERIFIED_DOMAIN=
SES_DAILY_LIMIT=200
SES_RATE_LIMIT=14

# Destinatarios (separados por coma) de la alerta de vencimiento de certificado SSL
# (scripts/production/ssl-expiry-mailer.js, invocado por ssl-expiry-check-cron.sh)
SSL_ALERT_EMAIL_TO=

# --- SAP Business One (Service Layer) ---
SAP_SERVICE_LAYER_URL=
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
SAP_GROUP_CODE=
SAP_INSTITUTIONAL_GROUP_CODE=
SAP_IMAGES_BASE_URL=
SAP_SYNC_SCHEDULE=
SAP_SYNC_BATCH_SIZE=

# Minutos que se pausan TODOS los logins de SAP (de cualquier servicio del proceso) tras
# detectar un error de credenciales (401/invalid_grant) al autenticarse. Default: 5.
SAP_LOGIN_CREDENTIAL_COOLDOWN_MINUTES=5

# --- Programación de órdenes ---
ORDER_SCHEDULER_ENABLED=true

# Destinatarios (separados por coma, se hace trim y se descartan vacíos) de la alerta de
# pedidos que fallaron al sincronizarse con SAP — se envía en el corte de las 18:05 (si hay
# fallos) y en el reintento (si hubo fallos definitivos y/o pedidos recuperados). Si falta,
# solo queda un WARNING en el log — no se interrumpe la sincronización.
ORDER_SYNC_ALERT_EMAIL_TO=

# Hora (America/Bogota, formato HH:MM 24h) del reintento automático del mismo día para
# pedidos que SAP rechazó en el corte de las 18:05. Si falta o el formato es inválido, se usa
# "23:00" y se registra un WARNING en el log.
ORDER_SYNC_RETRY_TIME=23:00

# --- Rutas internas (sincronizaciones disparadas por cron externo del servidor) ---
INTERNAL_SYNC_KEY=

# --- Archivos ---
FILE_UPLOAD_ENABLED=true
FILE_UPLOAD_MAX_SIZE=
FILE_UPLOAD_TEMP_DIR=

# --- Mantenimiento de tokens ---
TOKEN_CLEANUP_ENABLED=true
